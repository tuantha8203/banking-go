# Every configuration key read by the Go deployables (spine: BG_<SERVICE>_<KEY>; apps read env only).
# Local use: cp .env.example .env && set -a && . ./.env && set +a   (.env is git-ignored)
# Values shown are the defaults compiled into each service.

# --- shared ---------------------------------------------------------------------------------
# slog level: debug|info|warn|error (debug forbidden in prod)
LOG_LEVEL=info

# OpenTelemetry (AD-13). Leave the endpoint empty to disable exporting (no-op providers).
# With `make up-obs`: http://localhost:4317 and OTEL_EXPORTER_OTLP_INSECURE=true.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
# Optional standard SDK keys (sampling defaults to parentbased_always_on).
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_RESOURCE_ATTRIBUTES=

# --- core (gRPC) ----------------------------------------------------------------------------
BG_CORE_GRPC_ADDR=:8090
BG_CORE_ADMIN_ADDR=:9190
BG_CORE_ENVIRONMENT=local
BG_CORE_SHUTDOWN_TIMEOUT=30s

# --- core-worker ----------------------------------------------------------------------------
BG_CORE_WORKER_ADMIN_ADDR=:9191
BG_CORE_WORKER_ENVIRONMENT=local
BG_CORE_WORKER_SHUTDOWN_TIMEOUT=30s

# --- public-api -----------------------------------------------------------------------------
BG_PUBLIC_API_HTTP_ADDR=:8081
BG_PUBLIC_API_ADMIN_ADDR=:9181
BG_PUBLIC_API_ENVIRONMENT=local
BG_PUBLIC_API_SHUTDOWN_TIMEOUT=30s

# --- admin-api ------------------------------------------------------------------------------
BG_ADMIN_API_HTTP_ADDR=:8082
BG_ADMIN_API_ADMIN_ADDR=:9182
BG_ADMIN_API_ENVIRONMENT=local
BG_ADMIN_API_SHUTDOWN_TIMEOUT=30s

# --- partner mocks --------------------------------------------------------------------------
BG_MOCK_NAPAS_HTTP_ADDR=:8101
BG_MOCK_NAPAS_ADMIN_ADDR=:9201
BG_MOCK_NAPAS_ENVIRONMENT=local
BG_MOCK_NAPAS_SHUTDOWN_TIMEOUT=30s

BG_MOCK_EKYC_HTTP_ADDR=:8102
BG_MOCK_EKYC_ADMIN_ADDR=:9202
BG_MOCK_EKYC_ENVIRONMENT=local
BG_MOCK_EKYC_SHUTDOWN_TIMEOUT=30s

BG_MOCK_OTP_HTTP_ADDR=:8103
BG_MOCK_OTP_ADMIN_ADDR=:9203
BG_MOCK_OTP_ENVIRONMENT=local
BG_MOCK_OTP_SHUTDOWN_TIMEOUT=30s

BG_MOCK_GATEWAY_HTTP_ADDR=:8104
BG_MOCK_GATEWAY_ADMIN_ADDR=:9204
BG_MOCK_GATEWAY_ENVIRONMENT=local
BG_MOCK_GATEWAY_SHUTDOWN_TIMEOUT=30s
